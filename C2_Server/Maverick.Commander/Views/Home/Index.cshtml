@model ClientChatVM
@{
    ViewData["Title"] = "Client Console";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-2" style="height:90vh;">
    <div class="row h-100 border border-dark">
        <!-- LEFT: Client list -->
        <div class="col-3 border-end border-dark p-0">
            <div class="list-group list-group-flush">
                @if (Model?.Clients == null || !Model.Clients.Any())
                {
                    <div class="text-center text-muted p-3">No clients</div>
                }
                else
                {
                    foreach (var client in Model.Clients)
                    {
                        <a href="@Url.Action("Index", "Home", new { clientId = client.InternalID })"
                           class="list-group-item list-group-item-action text-primary">
                            @client.Hostname
                        </a>
                    }
                }
            </div>
        </div>

        <!-- RIGHT: Chat -->
        <div class="col-9 d-flex flex-column p-0">
            <div id="messageArea" class="flex-grow-1 overflow-auto p-3 bg-light">
                @if (string.IsNullOrEmpty(Model?.SelectedClientId))
                {
                    <div class="text-center text-muted mt-5">Chưa chọn client nào</div>
                }
                else if (Model.Histories == null || !Model.Histories.Any())
                {
                    <div class="text-center text-muted mt-5">Chưa có lịch sử trò chuyện</div>
                }
                else
                {
                    foreach (var history in Model.Histories)
                    {
                        var action = history.ActionDetails;
                        if (action == null) { continue; }

                        <!-- Command -->
                        <div class="d-flex align-items-start mb-3">
                            <div class="status-circle @GetCircleClass(history.Status) me-2"></div>
                            <div>
                                <div class="small text-muted">Command @history.DateTime.ToString("HH:mm:ss")</div>
                                <div class="p-2 rounded bg-warning-subtle border border-warning" style="min-width: 200px;">
                                    @action.Command
                                </div>
                            </div>
                        </div>

                        <!-- Response -->
                        @if (history.Status == CommandStatus.Responded && action.Data != null)
                        {
                            <div class="d-flex align-items-start mb-3">
                                <div class="status-circle done me-2"></div>
                                <div>
                                    <div class="small text-muted">Response</div>
                                    @switch (action.ActionType)
                                    {
                                        case "GETFILE":
                                            {
                                                var fileModel = System.Text.Json.JsonSerializer.Deserialize<FileUploadModel>(action.Data);
                                                if (fileModel != null)
                                                {
                                                    string base64Data = Convert.ToBase64String(fileModel.FileData);
                                                    string downloadUrl = $"data:application/octet-stream;base64,{base64Data}";
                                                    <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning-subtle" style="min-width: 200px;">
                                                        <i class="bi bi-file-earmark-arrow-down text-warning"></i>
                                                        <a href="@downloadUrl" download="@fileModel.FileName" class="text-decoration-none text-dark">
                                                            @fileModel.FileName
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-danger">Invalid file data</div>
                                                }
                                                break;
                                            }

                                        default:
                                            {
                                                // Textual response
                                                string text = System.Text.Encoding.UTF8.GetString(action.Data);
                                                <div class="p-2 rounded bg-warning bg-opacity-25 border border-warning-subtle" style="min-width: 200px; white-space: pre-wrap;">
                                                    @text
                                                </div>
                                                break;
                                            }
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Input area -->
            @if (!string.IsNullOrEmpty(Model?.SelectedClientId))
            {
                <div class="border-top border-dark p-2 bg-white d-flex align-items-center">
                    <label class="btn btn-outline-secondary btn-sm me-2 mb-0">
                        <i class="bi bi-paperclip"></i>
                        <input id="fileInput" type="file" hidden />
                    </label>
                    <div class="dropup me-2">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <span id="selectedCommandType">DOCOMMAND</span>
                        </button>
                        <ul class="dropdown-menu">
                            @foreach (var type in Enum.GetNames(typeof(CommandTypes)))
                            {
                                <li>
                                    <a class="dropdown-item cmd-type-item" href="#" data-type="@type">@type</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <input type="text" id="cmdInput" class="form-control me-2" placeholder="Enter command..." />
                    <button id="sendBtn" class="btn btn-dark rounded-circle">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .status-circle {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .status-circle.pending {
            border: 2px solid green;
            background-color: white;
        }

        .status-circle.done {
            background-color: green;
            position: relative;
        }

        .status-circle.done::after {
            content: "✓";
            color: white;
            font-size: 10px;
            position: absolute;
            top: -2px;
            left: 3px;
        }

        .bg-warning-subtle {
            background-color: #fff7cc !important;
        }

        .list-group-item.active {
            background-color: #e9ecef;
            border-color: #dee2e6;
        }

        .status-circle.received {
            background-color: orange;
            position: relative;
        }

        .status-circle.received::after {
            content: "";
            width: 8px;
            height: 2px;
            background: white;
            position: absolute;
            top: 6px;
            left: 3px;
        }

        #messageArea {
            overflow-y: auto; /* Enable vertical scrolling */
            max-height: 80vh; /* Set a maximum height to ensure scrolling happens if content exceeds the box */
        }


    </style>
}

@section Scripts {
    <script>
        document.getElementById("sendBtn")?.addEventListener("click", async function () {
            const input = document.getElementById("cmdInput");
            const selectedType = document.getElementById("selectedCommandType").innerText;
            const clientId = "@Model.SelectedClientId";
            const fileInput = document.getElementById("fileInput");

            let payload = {
                InternalID: parseInt(clientId),
                ActionType: selectedType,
                Command: null,
                Data: null,
                FileUpload: null
            };

            // ---------------------------
            // HANDLE SENDFILE
            // ---------------------------
            if (selectedType === "SENDFILE") {
                if (fileInput.files.length === 0) {
                    alert("Chưa chọn file để gửi!");
                    return;
                }

                let file = fileInput.files[0];
                let arrayBuffer = await file.arrayBuffer();
                let bytes = Array.from(new Uint8Array(arrayBuffer));

                payload.FileUpload = {
                    FileName: file.name,
                    FileData: bytes
                };

                payload.Command = file.name; // optional: đặt tên file làm command text
            }

            // ---------------------------
            // HANDLE NORMAL COMMANDS
            // ---------------------------
            else {
                if (!input.value.trim() && selectedType !== "INFOCLIENT") {
                    alert("Chưa nhập command!");
                    return;
                }

                payload.Command = input.value.trim();
            }

            // ---------------------------
            // SEND TO BACKEND
            // ---------------------------
            var sendUrl = '@Url.Action("SendCommand", "Command")';
            console.log("Sending payload:", JSON.stringify(payload, null, 2));
            const resp = await fetch(sendUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const errorData = await resp.json(); // Or resp.text() if not JSON
                console.error(`Error: Status ${resp.status}`, errorData);
                alert("Error sending command! Check console for details.");
                return;
            }

            // ---------------------------
            // LOCAL UI FEEDBACK
            // ---------------------------
            const msgArea = document.getElementById("messageArea");
            const cmd = document.createElement("div");
            cmd.classList.add("d-flex", "align-items-start", "mb-3");
            cmd.innerHTML = `
                <div class="status-circle pending me-2"></div>
                <div>
                    <div class="small text-muted">Command (${selectedType})</div>
                    <div class="p-2 rounded bg-warning-subtle border border-warning">
                        ${selectedType === "SENDFILE" ? "📎 " + payload.Command : payload.Command}
                    </div>
                </div>
            `;
            msgArea.appendChild(cmd);

            // clear input
            input.value = "";
            fileInput.value = "";
            msgArea.scrollTop = msgArea.scrollHeight;
        });

        // update dropdown selection

        document.querySelectorAll(".cmd-type-item").forEach(item => {
            item.addEventListener("click", () => {
                let type = item.dataset.type;
                document.getElementById("selectedCommandType").innerText = type;

                document.querySelectorAll(".cmd-type-item").forEach(x => x.classList.remove("active"));

                item.classList.add("active");
            });
        });

    </script>
}

@functions {
    string GetCircleClass(CommandStatus status)
    {
        return status switch
        {
            CommandStatus.Sent => "pending",
            CommandStatus.Received => "received",
            CommandStatus.Responded => "done",
            _ => "pending"
        };
    }
}

